GITHUB_USERNAME=luxuling

# Classic TOKEN: need scope read:user. Fine-grained: grant read to User + metadata for this user.
# 401 = bad/expired token, wrong file, or missing scope. No quotes around value.
GITHUB_TOKEN=

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# Random 32+ char secret for session HMAC signing
SESSION_SECRET=

# GitHub OAuth App (register at https://github.com/settings/developers)
# Callback URL: PUBLIC_SITE_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your site's public URL (used for OAuth redirect URI)
PUBLIC_SITE_URL=https://lxuu.dev
