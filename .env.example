GITHUB_USERNAME=luxuling

# Classic TOKEN: need scope read:user. Fine-grained: grant read to User + metadata for this user.
# 401 = bad/expired token, wrong file, or missing scope. No quotes around value.
GITHUB_TOKEN=

# Optional: external engagement API (views / likes / comments). Browser must be allowed by API CORS.
# PUBLIC_ENGAGEMENT_API_URL=https://your-api.example.com
