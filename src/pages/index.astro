---
import { getCollection } from 'astro:content';
import GitHubHome from '@/components/github-home.astro';
import HomeHighlights from '@/components/home-highlights.astro';
import StatusPage from '@/components/status-page.astro';
import { getGithubProfileCredentials } from '@/config/env';
import Layout from '@/layouts/layout.astro';
import { fetchGithubHome, type GithubHome } from '@/services/github';
import {
  sortByNewest,
  toPostListItem,
  toProjectListItem,
} from '@/utils/content-items';

const credentials = getGithubProfileCredentials();
let data: GithubHome | null = null;
let loadError =
  'Set GITHUB_USERNAME and GITHUB_TOKEN in .env. Token must stay server-side only.';

if (credentials) {
  try {
    data = await fetchGithubHome(credentials);
  } catch (error) {
    if (!(error instanceof Error)) throw error;
    loadError = error.message;
  }
}

const projectEntries = await getCollection(
  'projects',
  (entry) => entry.data.highlight,
);
const postEntries = await getCollection(
  'posts',
  (entry) => entry.data.status === 'posted' && entry.data.highlight,
);

const highlightedProjects = sortByNewest(projectEntries).map(toProjectListItem);
const highlightedPosts = sortByNewest(postEntries).map(toPostListItem);
---

<Layout pageTitle='welcome — lxuu.dev'>
  {
    data ? (
      <GitHubHome data={data} />
    ) : (
      <StatusPage title='Could not load GitHub profile' message={loadError} />
    )
  }
  <HomeHighlights projects={highlightedProjects} posts={highlightedPosts} />
</Layout>
