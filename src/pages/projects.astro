---
export const prerender = false;

import { getCollection } from 'astro:content';
import Layout from '@layouts/layout.astro';
import ProjectsExplorer from '@components/pages/projects';

const entries = await getCollection('projects');
const sorted = [...entries].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const projectItems = sorted.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  tags: entry.data.tags,
  status: entry.data.status,
  date: entry.data.date.toISOString().slice(0, 7),
  links: entry.data.links
    ? {
        github: entry.data.links.github ?? undefined,
        live: entry.data.links.live ?? undefined,
      }
    : undefined,
  highlight: entry.data.highlight,
}));
---

<Layout pageTitle='projects — lxuu.dev'>
  <ProjectsExplorer projects={projectItems} client:load />
</Layout>
