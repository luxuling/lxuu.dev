---
import { getCollection } from 'astro:content';
import { PostsExplorer } from '@/components/posts-explorer';
import Layout from '@/layouts/layout.astro';
import { sortByNewest, toPostListItem } from '@/utils/content-items';

export const prerender = false;

const entries = await getCollection(
  'posts',
  (entry) => entry.data.status === 'posted',
);
const posts = sortByNewest(entries).map(toPostListItem);
---

<Layout pageTitle='posts — lxuu.dev'>
  <PostsExplorer posts={posts} client:load />
</Layout>
