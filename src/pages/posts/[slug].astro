---
import { getEntry, render } from 'astro:content';
import { z } from 'astro/zod';
import Container from '@/components/container.astro';
import { Engagement } from '@/components/engagement';
import Link from '@/components/link.astro';
import LoadingImage from '@/components/loading-image.astro';
import { TableOfContents } from '@/components/table-of-contents';
import { TagList } from '@/components/tag-list';
import Layout from '@/layouts/layout.astro';
import { formatMonthYear } from '@/utils/format-date';
import { headingsToTocItems } from '@/utils/toc';

export const prerender = false;

const slug = z.string().parse(Astro.params.slug);
const entry = await getEntry('posts', slug);

if (!entry || entry.data.status === 'draft') {
  return Astro.redirect('/posts');
}

const { Content, headings } = await render(entry);
const { title, description, tags, date, thumbnail } = entry.data;
const tocItems = headingsToTocItems(headings);
---

<Layout pageTitle={`${title} — lxuu.dev`}>
  <section class='py-8 pb-20 sm:py-12 xl:pb-12'>
    <Container class='flex flex-col gap-8'>
      <div class='flex flex-col gap-4'>
        <Link href='/posts' class='font-mono text-xs text-subtle'>
          ← posts
        </Link>

        <div class='flex flex-col gap-2'>
          <div class='flex flex-wrap items-center gap-3'>
            <h1 class='text-xl font-semibold tracking-tight text-foreground'>
              {title}
            </h1>
            <span class='font-mono text-xs text-subtle'
              >{formatMonthYear(date)}</span
            >
          </div>
          <p class='text-sm text-muted-foreground'>{description}</p>
        </div>

        <TagList tags={tags} />
      </div>

      {
        thumbnail && (
          <LoadingImage
            src={thumbnail}
            alt={`${title} thumbnail`}
            frameClass='aspect-video w-full max-w-4xl rounded-md border border-edge'
            class='size-full object-cover'
          />
        )
      }

      <div class='h-px bg-edge'></div>

      <div class='flex gap-12'>
        <div class='min-w-0 flex-1'>
          <div class='prose-project'>
            <Content components={{ img: LoadingImage }} />
          </div>

          <Engagement client:load target='posts' slug={entry.id} />
        </div>

        {
          tocItems.length > 0 && (
            <aside class='xl:w-48 xl:shrink-0'>
              <div class='sticky top-10'>
                <TableOfContents client:load items={tocItems} />
              </div>
            </aside>
          )
        }
      </div>
    </Container>
  </section>
</Layout>
