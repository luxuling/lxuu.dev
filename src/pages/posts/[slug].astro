---
export const prerender = false;

import { getLiveEntry } from 'astro:content';
import Layout from '@layouts/layout.astro';
import Container from '@components/base/container.astro';
import Link from '@components/base/link.astro';
import PostEngagement from '@components/pages/posts/post-engagement';
import TableOfContents from '@components/pages/posts/table-of-contents';
import { extractAndInjectHeadings } from '@lib/posts/toc';

const { slug } = Astro.params;
const result = await getLiveEntry('posts', slug!);

if (result.error || !result.entry) {
  return Astro.redirect('/posts');
}

const post = result.entry;
const { title, description, tags, year, month, thumbnail, draft } = post.data;

if (draft) {
  return Astro.redirect('/posts');
}

const MONTHS = [
  'Jan',
  'Feb',
  'Mar',
  'Apr',
  'May',
  'Jun',
  'Jul',
  'Aug',
  'Sep',
  'Oct',
  'Nov',
  'Dec',
];
const monthLabel = MONTHS[(month - 1) % 12] ?? '';

const rawHtml = post.rendered?.html ?? '';
const { html: bodyHtml, items: tocItems } = extractAndInjectHeadings(rawHtml);

const engagementApiBase = import.meta.env.PUBLIC_ENGAGEMENT_API_URL ?? '';
---

<Layout pageTitle={`${title} — lxuu.dev`}>
  <section class='py-8 pb-20 sm:py-12 xl:pb-12'>
    <Container class='flex flex-col gap-8'>
      <div class='flex flex-col gap-4'>
        <Link href='/posts' class='font-mono text-xs text-subtle'>
          ← posts
        </Link>

        <div class='flex flex-col gap-2'>
          <div class='flex flex-wrap items-center gap-3'>
            <h1 class='text-xl font-semibold tracking-tight text-foreground'>
              {title}
            </h1>
            <span class='font-mono text-xs text-subtle'
              >{monthLabel} {year}</span
            >
          </div>
          <p class='text-sm text-muted-foreground'>{description}</p>
        </div>

        <div class='flex flex-wrap gap-1.5'>
          {
            tags.map((tag) => (
              <span class='rounded-sm border border-edge px-2 py-0.5 font-mono text-xs text-subtle'>
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      {
        thumbnail && (
          <img
            src={thumbnail}
            alt={`${title} thumbnail`}
            loading='lazy'
            class='aspect-video w-full max-w-4xl rounded-md border border-edge object-cover'
          />
        )
      }

      <div class='h-px bg-edge'></div>

      <div class='flex gap-12'>
        <div class='min-w-0 flex-1'>
          <div class='prose-project' set:html={bodyHtml} />

          <PostEngagement
            client:load
            postSlug={slug!}
            apiBase={engagementApiBase}
          />
        </div>

        {
          tocItems.length > 0 && (
            <aside class='xl:w-48 xl:shrink-0'>
              <div class='sticky top-10'>
                <TableOfContents client:load items={tocItems} />
              </div>
            </aside>
          )
        }
      </div>
    </Container>
  </section>
</Layout>
