---
import { getEntry, render } from 'astro:content';
import { z } from 'astro/zod';
import ArticleLayout from '@/components/article-layout.astro';
import { CardStats } from '@/components/card-stats';
import ContentLink from '@/components/content-link.astro';
import ZoomImage from '@/components/zoom-image.astro';
import Layout from '@/layouts/layout.astro';
import { formatMonthYear } from '@/utils/format-date';
import { headingsToTocItems } from '@/utils/toc';

export const prerender = false;

const slug = z.string().parse(Astro.params.slug);
const entry = await getEntry('posts', slug);

if (!entry || entry.data.status === 'draft') {
  return Astro.redirect('/posts');
}

const { Content, headings } = await render(entry);
const { title, description, tags, date, thumbnail } = entry.data;
---

<Layout pageTitle={`${title} — lxuu.dev`}>
  <ArticleLayout
    target='posts'
    slug={entry.id}
    title={title}
    description={description}
    tags={tags}
    thumbnail={thumbnail}
    tocItems={headingsToTocItems(headings)}
  >
    <Fragment slot='meta'>
      <span class='text-fg-muted'>[posted]</span> ·
      <span class='lowercase'>{formatMonthYear(date)}</span> ·
      <CardStats client:load target='posts' slug={entry.id} separator=' · ' />
    </Fragment>

    <Content components={{ a: ContentLink, img: ZoomImage }} />
  </ArticleLayout>
</Layout>
