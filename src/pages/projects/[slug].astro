---
import { getEntry, render } from 'astro:content';
import { z } from 'astro/zod';
import Container from '@/components/container.astro';
import { Engagement } from '@/components/engagement';
import Link from '@/components/link.astro';
import LoadingImage from '@/components/loading-image.astro';
import { TableOfContents } from '@/components/table-of-contents';
import { TagList } from '@/components/tag-list';
import Layout from '@/layouts/layout.astro';
import { fetchGithubStarCount } from '@/services/github';
import { formatMonthYear } from '@/utils/format-date';
import { STATUS_COLOR, STATUS_LABEL } from '@/utils/project-status';
import { headingsToTocItems } from '@/utils/toc';

export const prerender = false;

const slug = z.string().parse(Astro.params.slug);
const entry = await getEntry('projects', slug);

if (!entry) {
  return Astro.redirect('/projects');
}

const { Content, headings } = await render(entry);
const tocItems = headingsToTocItems(headings);
const { title, description, tags, status, date, thumbnail, links } = entry.data;

const githubStars = links?.github
  ? await fetchGithubStarCount(links.github, import.meta.env.GITHUB_TOKEN)
  : null;
---

<Layout pageTitle={`${title} — lxuu.dev`}>
  <section class='py-8 pb-20 sm:py-12 xl:pb-12'>
    <Container class='flex flex-col gap-8'>
      <div class='flex flex-col gap-4'>
        <Link href='/projects' class='font-mono text-xs text-subtle'>
          ← projects
        </Link>

        <div class='flex flex-col gap-2'>
          <div class='flex flex-wrap items-center gap-3'>
            <h1 class='text-xl font-semibold tracking-tight text-foreground'>
              {title}
            </h1>
            <span class:list={['font-mono text-xs', STATUS_COLOR[status]]}>
              {STATUS_LABEL[status]}
            </span>
            <span class='font-mono text-xs text-subtle'
              >{formatMonthYear(date)}</span
            >
          </div>
          <p class='text-sm text-muted-foreground'>{description}</p>
        </div>

        <div class='flex flex-wrap items-center gap-4'>
          <TagList tags={tags} />
        </div>
      </div>

      {
        thumbnail && (
          <LoadingImage
            src={thumbnail}
            alt={`${title} thumbnail`}
            frameClass='aspect-video w-full max-w-4xl rounded-md border border-edge'
            class='size-full object-cover'
          />
        )
      }

      {
        (links?.github || links?.live) && (
          <div class='flex items-center gap-4 text-sm'>
            {links?.live && (
              <Link href={links.live} target='_blank'>
                ↗ live site
              </Link>
            )}
            {links?.github && (
              <>
                <Link href={links.github} target='_blank'>
                  ⌥ source
                </Link>
                {githubStars !== null && (
                  <span class='text' aria-label='GitHub stars'>
                    ★ {githubStars.toLocaleString()}
                  </span>
                )}
              </>
            )}
          </div>
        )
      }

      <div class='h-px bg-edge'></div>

      <div class='flex gap-12'>
        <div class='min-w-0 flex-1'>
          <div class='prose-project'>
            <Content components={{ img: LoadingImage }} />
          </div>

          <Engagement client:load target='projects' slug={entry.id} />
        </div>

        {
          tocItems.length > 0 && (
            <aside class='xl:w-48 xl:shrink-0'>
              <div class='sticky top-10'>
                <TableOfContents client:load items={tocItems} />
              </div>
            </aside>
          )
        }
      </div>
    </Container>
  </section>
</Layout>
