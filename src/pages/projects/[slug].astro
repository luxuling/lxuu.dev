---
import { getEntry, render } from 'astro:content';
import { z } from 'astro/zod';
import ArticleLayout from '@/components/article-layout.astro';
import { CardStats } from '@/components/card-stats';
import ContentLink from '@/components/content-link.astro';
import ZoomImage from '@/components/zoom-image.astro';
import { getGithubProfileCredentials } from '@/config/env';
import Layout from '@/layouts/layout.astro';
import { fetchGithubStarCount } from '@/services/github';
import { formatMonthYear } from '@/utils/format-date';
import { STATUS_LABEL } from '@/utils/project-status';
import { headingsToTocItems } from '@/utils/toc';

export const prerender = false;

const slug = z.string().parse(Astro.params.slug);
const entry = await getEntry('projects', slug);

if (!entry) {
  return Astro.redirect('/projects');
}

const { Content, headings } = await render(entry);
const { title, description, tags, status, date, thumbnail, links } = entry.data;

const githubStars = links?.github
  ? await fetchGithubStarCount(
      links.github,
      getGithubProfileCredentials()?.token,
    )
  : null;
---

<Layout pageTitle={`${title} — lxuu.dev`}>
  <ArticleLayout
    target='projects'
    slug={entry.id}
    title={title}
    description={description}
    tags={tags}
    thumbnail={thumbnail}
    tocItems={headingsToTocItems(headings)}
  >
    <Fragment slot='meta'>
      <span class='text-fg-muted'>{STATUS_LABEL[status]}</span> ·
      <span class='lowercase'>{formatMonthYear(date)}</span> ·
      <CardStats
        client:load
        target='projects'
        slug={entry.id}
        separator=' · '
      />
    </Fragment>

    {(links?.live || links?.github) && (
      <p slot='links' class='mt-1 flex flex-wrap gap-6 text-small'>
        {links?.live && (
          <a
            href={links.live}
            target='_blank'
            rel='noreferrer'
            class='text-fg hover:underline'
          >
            [↗] live site
          </a>
        )}
        {links?.github && (
          <a
            href={links.github}
            target='_blank'
            rel='noreferrer'
            class='text-fg hover:underline'
          >
            &lt;/&gt; source
          </a>
        )}
        {githubStars !== null && (
          <span class='text-fg-muted' aria-label='GitHub stars'>
            [*] {githubStars.toLocaleString()}
          </span>
        )}
      </p>
    )}

    <Content components={{ a: ContentLink, img: ZoomImage }} />
  </ArticleLayout>
</Layout>
