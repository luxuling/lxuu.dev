---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props as Props;
---

{
  title ? (
    <div
      class:list={[
        'overflow-hidden rounded-md border border-edge bg-panel',
        className,
      ]}
    >
      <div class='border-b border-edge px-4 py-3 md:px-6'>
        <h2 class='text-sm font-semibold uppercase tracking-[0.14em]'>
          {title}
        </h2>
      </div>
      <div class='px-4 py-5 md:px-6'>
        <slot />
      </div>
    </div>
  ) : (
    <div
      class:list={[
        'rounded-md border border-edge bg-panel p-4 sm:p-6',
        className,
      ]}
    >
      <slot />
    </div>
  )
}
