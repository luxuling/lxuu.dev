---
interface Props {
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const {
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props as Props;
---

<button
  type={type}
  {...rest}
  class:list={[
    'inline-flex items-center rounded-sm bg-foreground px-3 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90',
    className,
  ]}
>
  <slot />
</button>
