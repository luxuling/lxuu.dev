---
import ZoomImage from '@/components/zoom-image.astro';

interface Props {
  src: string;
  alt?: string;
  // NOTE: Keystatic stores the image size as the markdown title
  title?: string;
}

const SIZE_CLASS: Record<string, string> = {
  small: 'md:w-1/2',
  medium: 'md:w-3/4',
};

const { src, alt = '', title = '' } = Astro.props;
---

<div class:list={SIZE_CLASS[title]}>
  <ZoomImage src={src} alt={alt} />
</div>
