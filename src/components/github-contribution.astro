---
import { SectionLabel } from '@/components/section-label';
import type { GithubHome } from '@/services/github';
import {
  CONTRIBUTION_LEGEND_LEVELS,
  columnCells,
  fillForCount,
  glyphForCount,
  monthLabelsForWeeks,
} from '@/utils/contribution-graph';

interface Props {
  data: Pick<
    GithubHome,
    'totalContributions' | 'weeks' | 'login' | 'profileUrl'
  >;
}

const { data } = Astro.props;
const monthLabels = monthLabelsForWeeks(data.weeks);
const DAY_LABELS = ['', 'mon', '', 'wed', '', 'fri', ''];
---

<section class='flex flex-col gap-4'>
  <SectionLabel meta='github'>contributions</SectionLabel>

  <div class='flex flex-col gap-4 border border-line bg-surface/40 p-4 md:p-6'>
    <div class='flex items-center justify-between gap-4'>
      <p class='text-small font-semibold text-fg-muted'>
        <span class='text-fg'>{data.totalContributions.toLocaleString()}</span>
        contributions in the last year
      </p>
      <a
        href={data.profileUrl}
        target='_blank'
        rel='noopener noreferrer'
        class='text-micro text-fg-subtle hover:text-fg'
      >
        @{data.login}
      </a>
    </div>

    <div
      class='flex text-small/3.5 text-fg-subtle'
      role='img'
      aria-label={`${data.totalContributions} GitHub contributions in the last year`}
    >
      <div class='flex w-[4ch] shrink-0 flex-col' aria-hidden='true'>
        <span>&nbsp;</span>
        {DAY_LABELS.map((label) => (
          <span>{label || ' '}</span>
        ))}
      </div>

      <div dir='rtl' class='contrib-scroll min-w-0 flex-1 overflow-x-auto pb-1'>
        <div dir='ltr' class='flex min-w-full' aria-hidden='true'>
          {data.weeks.map((week, index) => (
            <div class='flex w-[2ch] shrink-0 flex-col'>
              <span class='relative'>
                {monthLabels[index] && (
                  <span class='absolute left-0 whitespace-nowrap lowercase'>
                    {monthLabels[index]}
                  </span>
                )}
                &nbsp;
              </span>
              {columnCells(week).map((day) =>
                day ? (
                  <span
                    title={`${day.contributionCount} contributions on ${day.date}`}
                    style={{ color: fillForCount(day.contributionCount) }}
                  >
                    {glyphForCount(day.contributionCount)}
                  </span>
                ) : (
                  <span>&nbsp;</span>
                ),
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class='flex flex-col gap-2 text-micro text-fg-subtle md:flex-row md:items-center md:justify-between'>
      <a
        href='https://docs.github.com/en/account-and-profile/how-tos/contribution-settings/troubleshooting-missing-contributions'
        target='_blank'
        rel='noopener noreferrer'
        class='hover:text-fg'
      >
        how we count contributions [↗]
      </a>

      <p class='flex shrink-0 items-center gap-2'>
        <span>less</span>
        <span class='flex gap-[1ch]'>
          {CONTRIBUTION_LEGEND_LEVELS.map((level) => (
            <span style={{ color: fillForCount(level) }}>
              {glyphForCount(level)}
            </span>
          ))}
        </span>
        <span>more</span>
      </p>
    </div>
  </div>
</section>
