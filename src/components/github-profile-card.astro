---
import BaseCard from '@/components/base-card.astro';
import LoadingImage from '@/components/loading-image.astro';
import type { GithubHome } from '@/services/github';

interface Props {
  data: GithubHome;
}

const { data } = Astro.props;
---

<BaseCard>
  <article class='flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-8'>
    <LoadingImage
      src={data.avatarUrl}
      alt=''
      width='120'
      height='120'
      frameClass='mx-auto size-24 shrink-0 rounded-full border border-edge sm:mx-0 sm:size-30'
      class='size-full object-cover'
    />
    <div class='min-w-0 flex-1 text-center sm:text-left'>
      <h1
        class='text-lg font-semibold tracking-tight text-foreground sm:text-xl'
      >
        {data.name ?? data.login}
      </h1>
      <p class='mt-0.5 text-sm text-muted-foreground'>
        <a
          href={data.profileUrl}
          target='_blank'
          rel='noopener noreferrer'
          class='text-muted-foreground underline-offset-4 hover:text-foreground hover:underline'
        >
          @{data.login}
        </a>
      </p>
      {
        data.bio ? (
          <p class='mt-3 text-sm/relaxed text-pretty text-muted-foreground'>
            {data.bio}
          </p>
        ) : null
      }
      <div
        class='mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:justify-start'
      >
        <p class='text-sm'>
          <span class='text-foreground tabular-nums'>{data.followers}</span>
          <span class='text-subtle'> followers</span>
        </p>
        <p class='text-sm'>
          <span class='text-foreground tabular-nums'>{data.following}</span>
          <span class='text-subtle'> following</span>
        </p>
        <p class='text-sm'>
          <span class='text-foreground tabular-nums'>{data.publicRepos}</span>
          <span class='text-subtle'> repos</span>
        </p>
      </div>
    </div>
  </article>
</BaseCard>
