---
import Page from '@/components/page.astro';
import { PageHeader } from '@/components/page-header';
import { SectionLabel } from '@/components/section-label';
import ZoomImage from '@/components/zoom-image.astro';
import tools from '@/data/tools.json';

const indexLabel = (index: number) => String(index + 1).padStart(2, '0');
---

<Page>
  <PageHeader path='~/set-up' title='set up' subtitle={tools.tagline} />

  <figure class='flex flex-col gap-2'>
    <ZoomImage
      src={tools.screenshot.src}
      alt={tools.screenshot.alt}
      frameClass='border border-line bg-surface'
      class='w-full object-cover'
    />
    <figcaption class='text-micro text-fg-subtle'>
      {tools.screenshot.caption} ·
      <span class='hidden md:inline'>click to zoom</span>
      <span class='md:hidden'>tap to zoom</span>
    </figcaption>
  </figure>

  <section class='flex flex-col gap-4'>
    <SectionLabel>why linux</SectionLabel>
    <div class='flex max-w-174 flex-col gap-4 text-body text-fg-muted'>
      {tools.whyLinux.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class='flex flex-col gap-4'>
    <SectionLabel meta={`${tools.tools.length} tools`}>setup</SectionLabel>
    <ul class='flex flex-col'>
      {tools.tools.map((tool, index) => (
        <li class='flex flex-col gap-1 border-b border-line py-4 md:flex-row md:gap-6'>
          <span class='text-small text-fg-muted md:w-60 md:shrink-0 md:text-body'>
            <span class='text-fg-subtle'>{indexLabel(index)}</span>
            <span class='whitespace-pre'>{`  ${tool.category.toLowerCase()}`}</span>
          </span>
          <a
            href={tool.href}
            target='_blank'
            rel='noreferrer'
            class='group text-body font-semibold text-fg hover:underline md:w-50 md:shrink-0'
          >
            {tool.name}{' '}
            <span class='font-normal text-fg-subtle transition-colors group-hover:text-fg'>
              [↗]
            </span>
          </a>
          <p class='text-body text-fg-muted'>{tool.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Page>
