---
import Container from '@/components/container.astro';
import Button from '@/components/button.astro';
import Logo from '@/components/logo.astro';
import { MobileNav } from '@/components/mobile-nav';
import { EMAIL, NAV_ITEMS, isActivePath } from '@/data/site';

const { pathname } = Astro.url;
---

<header class='relative z-50 border-b border-line'>
  <Container class='flex h-14 items-center justify-between md:h-16'>
    <Logo />

    <nav class='hidden items-center gap-4 text-body md:flex'>
      {NAV_ITEMS.map((item) => {
        const isActive = isActivePath(pathname, item.href);

        return (
          <a
            href={item.href}
            class:list={[
              'flex transition-colors hover:text-fg',
              isActive ? 'text-fg' : 'text-fg-muted',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class:list={[!isActive && 'invisible']} aria-hidden='true'>
              [
            </span>
            {item.label}
            <span class:list={[!isActive && 'invisible']} aria-hidden='true'>
              ]
            </span>
          </a>
        );
      })}
    </nav>

    <Button href={`mailto:${EMAIL}`} class='max-md:hidden'>
      [@] hire me
    </Button>

    <MobileNav currentPath={pathname} client:load />
  </Container>
</header>
