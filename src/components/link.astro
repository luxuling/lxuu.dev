---
interface Props {
  href: string;
  label?: string;
  class?: string;
  target?: string;
  rel?: string;
}

const { href, label, class: className = '', target, rel } = Astro.props;

const baseClass = 'text-foreground underline-offset-4 hover:underline';
---

<a href={href} class:list={[baseClass, className]} target={target} rel={rel}>
  {label ? label : <slot />}
</a>
