---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

{title ? (
  <div
    class:list={['overflow-hidden border border-line bg-surface', className]}
  >
    <div class='border-b border-line px-4 py-3 md:px-6'>
      <h2 class='text-sm font-semibold tracking-[0.14em] uppercase'>{title}</h2>
    </div>
    <div class='px-4 py-5 md:px-6'>
      <slot />
    </div>
  </div>
) : (
  <div class:list={[' border border-line bg-surface p-4 sm:p-6', className]}>
    <slot />
  </div>
)}
