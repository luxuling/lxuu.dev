---
import Page from '@/components/page.astro';
import { PageHeader } from '@/components/page-header';
import { SectionLabel } from '@/components/section-label';
import { TagLine } from '@/components/tag-list';
import me from '@/data/me.json';
import { formatMonthYear } from '@/utils/format-date';

const isCurrent = (period: string) => period.endsWith('present');

const shortPeriod = (period: string) =>
  period.replace(/\b([A-Z][a-z]{2})[a-z]+/g, '$1').toLowerCase();

const placeLabel = (location: string, period: string) =>
  [location.toLowerCase(), isCurrent(period) && 'current']
    .filter(Boolean)
    .join(' · ');

const countLabel = String(me.experiences.length).padStart(2, '0');
---

<Page>
  <PageHeader path='~/me' title='me' subtitle={me.tagline} />

  <section class='flex flex-col gap-4'>
    <SectionLabel>summary</SectionLabel>
    <div class='flex max-w-174 flex-col gap-4 text-body text-fg-muted'>
      {me.summaryParagraphs.map((segments) => (
        <p>
          {segments.map((seg) =>
            seg.emphasis ? (
              <strong class='font-semibold text-fg'>{seg.text}</strong>
            ) : (
              seg.text
            ),
          )}
        </p>
      ))}
      <blockquote class='mt-2 flex flex-col gap-2 border-l border-line-strong py-1 pl-4 md:pl-6'>
        <p class='text-fg'>&ldquo;{me.quote.body}&rdquo;</p>
        <footer class='text-small text-fg-subtle'>
          {me.quote.attribution}{' '}
          <cite class='not-italic'>{me.quote.citation}</cite>
        </footer>
      </blockquote>
    </div>
  </section>

  <section class='flex flex-col gap-4'>
    <SectionLabel meta={formatMonthYear(new Date()).toLowerCase()}>
      now
    </SectionLabel>
    <ul class='flex max-w-174 flex-col gap-3 text-body'>
      {me.nowItems.map((item) => {
        const isDone = item.tone === 'subtle';

        return (
          <li class='flex gap-3'>
            <span
              class:list={['shrink-0', isDone ? 'text-fg-subtle' : 'text-fg']}
            >
              {isDone ? '[ ]' : '[o]'}
            </span>
            <span class:list={[isDone ? 'text-fg-subtle' : 'text-fg-muted']}>
              {item.segments.map((seg) => {
                if (seg.href)
                  return (
                    <a
                      href={seg.href}
                      target='_blank'
                      rel='noreferrer'
                      class='text-fg underline underline-offset-4'
                      set:text={seg.text}
                    />
                  );
                if (seg.emphasis)
                  return (
                    <strong class='font-semibold text-fg'>{seg.text}</strong>
                  );

                return seg.text;
              })}
            </span>
          </li>
        );
      })}
    </ul>
  </section>

  <section class='flex flex-col'>
    <SectionLabel meta={countLabel}>experiences</SectionLabel>
    <div class='flex flex-col'>
      {me.experiences.map((exp) => {
        const current = isCurrent(exp.period);

        return (
          <article class='flex flex-col gap-2 border-b border-line py-6 last:border-b-0 md:gap-3 md:py-8'>
            <header class='flex flex-col gap-2 md:flex-row md:items-center md:justify-between md:gap-6'>
              <h3 class='text-body text-fg-muted'>
                <span class:list={[current ? 'text-fg' : 'text-fg-subtle']}>
                  {current ? '[*]' : '[o]'}
                </span>{' '}
                <span class='font-semibold text-fg'>{exp.role}</span>{' '}
                <a
                  href={exp.companyUrl}
                  target='_blank'
                  rel='noreferrer'
                  class='underline underline-offset-4 hover:text-fg'
                >
                  @{exp.company}
                </a>
              </h3>
              <p
                class:list={[
                  'shrink-0 text-small',
                  current ? 'text-fg' : 'text-fg-subtle',
                ]}
              >
                <span class='hidden md:inline'>{exp.period.toLowerCase()}</span>
                <span class='md:hidden'>
                  {shortPeriod(exp.period)} ·{' '}
                  {placeLabel(exp.location, exp.period)}
                </span>
              </p>
            </header>

            <div class='flex flex-col gap-3 md:pl-8'>
              <p class='hidden text-small text-fg-subtle md:block'>
                {placeLabel(exp.location, exp.period)}
              </p>
              <ul class='flex flex-col gap-2 pt-2 text-body text-fg-muted md:pt-0'>
                {exp.bullets.map((bullet) => (
                  <li class='flex gap-3'>
                    <span class='shrink-0 text-fg-subtle'>-</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <TagLine tags={exp.tags} />
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Page>
