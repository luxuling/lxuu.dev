---
import BaseCard from '@/components/base-card.astro';
import Container from '@/components/container.astro';
import Link from '@/components/link.astro';
import me from '@/data/me.json';

const data = me;
---

<section class='py-8 sm:py-12'>
  <Container class='flex flex-col gap-6'>
    <div class='px-1'>
      <h1 class='text-xl font-semibold tracking-tight text-fg'>
        me<span class='text-fg-muted'>.</span>
      </h1>
      <p class='mt-1 text-sm text-fg-subtle'>{data.tagline}</p>
    </div>

    <BaseCard title='[ summary ]'>
      <div class='flex flex-col gap-5'>
        <div class='flex flex-col gap-3 text-sm/relaxed text-fg-muted'>
          {data.summaryParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <blockquote class='border-l-2 border-line pl-4 text-sm text-fg-subtle italic'>
          <p>&ldquo;{data.quote.body}&rdquo;</p>
          <footer class='mt-2 text-fg-subtle not-italic'>
            {data.quote.attribution} <cite>{data.quote.citation}</cite>
          </footer>
        </blockquote>
      </div>
    </BaseCard>

    <BaseCard title='[ now ]'>
      <ul class='flex flex-col gap-3'>
        {data.nowItems.map((item) => {
          const outer =
            item.tone === 'subtle' ? 'text-fg-subtle' : 'text-fg-muted';
          const marker = item.tone === 'subtle' ? 'text-fg-subtle' : 'text-fg';
          return (
            <li class='flex items-center gap-3 text-sm'>
              <span class:list={['shrink-0', 'font-mono', marker]}>[o]</span>
              <span class={outer}>
                {item.segments.map((seg) => {
                  if (seg.href) {
                    return (
                      <Link href={seg.href} target='_blank'>
                        {seg.text}
                      </Link>
                    );
                  }
                  if (seg.emphasis) {
                    return <span class='text-fg'>{seg.text}</span>;
                  }
                  return seg.text;
                })}
              </span>
            </li>
          );
        })}
      </ul>
    </BaseCard>

    <BaseCard title='[ experiences ]'>
      <div class='flex flex-col space-y-6 divide-y divide-line'>
        {data.experiences.map((exp) => (
          <div class='flex flex-col gap-3 pb-6'>
            <div class='flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between'>
              <div class='flex flex-wrap items-baseline gap-x-2 gap-y-1'>
                <span
                  class:list={[
                    'font-mono',
                    'text-sm',
                    exp.period.includes('present')
                      ? 'text-fg'
                      : 'text-fg-subtle',
                  ]}
                >
                  [o]
                </span>
                <span class='text-sm font-medium text-fg'>{exp.role}</span>
                <Link href={exp.companyUrl} target='_blank'>
                  <span class='text-sm text-fg-subtle'>@</span>
                  <span class='text-sm text-fg'>{exp.company}</span>
                </Link>
                <span class='font-mono text-sm text-fg-subtle'>
                  · {exp.location}
                </span>
              </div>
              <span class='ml-5 font-mono text-sm text-fg-subtle sm:ml-0'>
                {exp.period}
              </span>
            </div>
            <ul class='ml-5 flex flex-col gap-1.5'>
              {exp.bullets.map((b) => (
                <li class='flex items-start gap-2 text-sm text-fg-muted'>
                  <span class='mt-1.5 size-1 shrink-0 bg-fg-subtle' />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <div class='ml-5 flex flex-wrap gap-2'>
              {exp.tags.map((tag) => (
                <span class='border border-line px-2 py-0.5 font-mono text-xs text-fg-subtle'>
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </BaseCard>
  </Container>
</section>
