---
import Container from '@/components/container.astro';
import Button from '@/components/button.astro';
import { EMAIL, NAV_ITEMS, SOCIAL_LINKS } from '@/data/site';
import { FOOTER_CAT } from '@/utils/ascii-art';
---

<footer class='relative overflow-hidden border-t border-line'>
  <Container class='flex flex-col gap-8 pt-16 md:gap-12 md:pt-24'>
    <div class='flex flex-col gap-6 md:flex-row md:items-end md:justify-between'>
      <div class='flex flex-col gap-3'>
        <p class='text-label font-semibold text-fg-muted uppercase'>
          [ contact ]
        </p>
        <h2 class='text-h1 font-bold text-fg'>
          have an idea? let's build it<span class='text-fg-subtle'>.</span>
        </h2>
        <a
          href={`mailto:${EMAIL}`}
          class='text-body text-fg-muted hover:text-fg'
        >
          {EMAIL}
        </a>
      </div>
      <Button href={`mailto:${EMAIL}`} class='self-start md:self-auto'>
        [@] hire me
      </Button>
    </div>

    <ul class='grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4'>
      {SOCIAL_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            target='_blank'
            rel='noreferrer'
            class='flex flex-col gap-1 border border-line bg-surface/40 p-4 transition-colors hover:bg-surface-2'
          >
            <span class='flex justify-between text-small'>
              <span class='text-fg'>
                [{link.key}] {link.label}
              </span>
              <span class='text-fg-subtle'>[↗]</span>
            </span>
            <span class='text-micro text-fg-subtle'>{link.handle}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class='flex flex-col gap-2 text-micro text-fg-subtle md:flex-row md:justify-between'>
      <p>© 2026 lixu ling · yogyakarta</p>
      <nav aria-label='Footer'>
        {NAV_ITEMS.map((item, index) => (
          <>
            {index > 0 && ' · '}
            <a href={item.href} class='hover:text-fg'>
              {item.label}
            </a>
          </>
        ))}
      </nav>
    </div>

    <div class='relative flex justify-center' aria-hidden='true'>
      <div class='footer-glow absolute inset-x-[-50vw] -top-14 bottom-0'></div>
      <pre class='ascii relative text-[9px]/[10px] text-fg opacity-22 md:text-sm/4'>{FOOTER_CAT}</pre>
    </div>
  </Container>
</footer>
