---
import BaseCard from '@components/base/base-card.astro';
import Container from '@components/base/container.astro';
import Link from '@components/base/link.astro';
import tools from '@lib/data/tools.json';

const data = tools;
---

<section class='py-8 sm:py-12'>
  <Container class='flex flex-col gap-6'>
    <div class='px-1'>
      <h1 class='text-xl font-semibold tracking-tight text-foreground'>
        set up<span class='text-muted-foreground'>.</span>
      </h1>
      <p class='mt-1 text-sm text-subtle'>{data.tagline}</p>
    </div>

    <BaseCard>
      <img
        src={data.screenshot.src}
        alt={data.screenshot.alt}
        class='w-full rounded-sm object-cover'
        loading='lazy'
      />
    </BaseCard>

    <BaseCard title='[ why linux ]'>
      <div
        class='flex flex-col gap-3 text-sm leading-relaxed text-muted-foreground'
      >
        {data.whyLinux.map((p) => <p>{p}</p>)}
      </div>
    </BaseCard>

    <BaseCard title='[ setup ]'>
      <div class='flex flex-col divide-y divide-edge'>
        {
          data.tools.map((tool) => (
            <div class='flex flex-col gap-1 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:gap-0'>
              <span class='w-44 shrink-0 font-mono text-xs text-subtle'>
                {tool.category}
              </span>
              <div class='flex flex-col gap-0.5'>
                <Link
                  href={tool.href}
                  target='_blank'
                  class='text-sm font-medium'
                >
                  {tool.name}
                </Link>
                <p class='text-sm text-muted-foreground'>{tool.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </BaseCard>
  </Container>
</section>
