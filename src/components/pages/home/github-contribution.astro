---
import BaseCard from '@components/base/base-card.astro';
import type { GitHubHomeData } from '@lib/services/github.service';
import {
  CONTRIBUTION_LEGEND_LEVELS,
  columnCells,
  fillForCount,
  monthLabelsForWeeks,
} from '@lib/helpers/github.helper';

interface Props {
  data: Pick<GitHubHomeData, 'totalContributions' | 'weeks'>;
}

const { data } = Astro.props as Props;
const monthLabels = monthLabelsForWeeks(data.weeks);
---

<BaseCard>
  <div
    class='flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between'
  >
    <p class='text-sm text-foreground'>
      <span class='font-medium'>{data.totalContributions.toLocaleString()}</span
      >
      <span class='text-muted-foreground'> contributions in the last year</span>
    </p>
  </div>

  <div
    class='mt-4 flex gap-2'
    role='img'
    aria-label={`${data.totalContributions} GitHub contributions in the last year`}
  >
    <div
      class='hidden w-7 shrink-0 flex-col justify-between py-px text-[10px] leading-none text-subtle sm:flex'
      aria-hidden='true'
    >
      <span class='invisible'>.</span>
      <span>Mon</span>
      <span class='invisible'>.</span>
      <span>Wed</span>
      <span class='invisible'>.</span>
      <span>Fri</span>
      <span class='invisible'>.</span>
      <span class='invisible'>.</span>
    </div>

    <div class='contrib-scroll min-w-0 flex-1 overflow-x-auto pb-1'>
      <div class='inline-block min-w-max'>
        <div class='mb-1 flex gap-0.75'>
          {
            data.weeks.map((_, i) => (
              <div class='relative flex h-4 w-2.5 shrink-0 justify-center sm:w-3'>
                {monthLabels[i] ? (
                  <span class='absolute top-0 left-0 whitespace-nowrap text-[10px] text-subtle'>
                    {monthLabels[i]}
                  </span>
                ) : null}
              </div>
            ))
          }
        </div>

        <div class='flex gap-0.75'>
          {
            data.weeks.map((week) => (
              <div class='flex flex-col gap-0.75'>
                {columnCells(week).map((day) =>
                  day ? (
                    <div
                      title={`${day.contributionCount} contributions on ${day.date}`}
                      class='size-2.5 rounded-xs sm:size-3'
                      style={{
                        backgroundColor: fillForCount(day.contributionCount),
                      }}
                    />
                  ) : (
                    <div class='size-2.5 sm:size-3' />
                  ),
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div
    class='mt-4 flex flex-col gap-3 border-t border-edge pt-4 text-[11px] text-subtle sm:flex-row sm:items-center sm:justify-between'
  >
    <a
      href='https://docs.github.com/en/account-and-profile/how-tos/contribution-settings/troubleshooting-missing-contributions'
      target='_blank'
      rel='noopener noreferrer'
      class='text-subtle hover:text-foreground hover:underline underline-offset-4'
    >
      How we count contributions
    </a>

    <div class='flex items-center gap-2'>
      <span>Less</span>
      <div class='flex gap-1'>
        {
          CONTRIBUTION_LEGEND_LEVELS.map((level) => (
            <div
              class='size-2.5 rounded-xs sm:size-3'
              style={{ backgroundColor: fillForCount(level) }}
            />
          ))
        }
      </div>
      <span>More</span>
    </div>
  </div>
</BaseCard>
