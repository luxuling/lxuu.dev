---
import { buttonClass, type ButtonVariant } from '@/utils/button-class';

interface Props {
  href?: string;
  variant?: ButtonVariant;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const classes = [buttonClass(variant), className];
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
  </button>
)}
