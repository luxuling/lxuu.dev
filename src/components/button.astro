---
interface Props {
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const { type = 'button', class: className = '', ...rest } = Astro.props;
---

<button
  type={type}
  {...rest}
  class:list={[
    'inline-flex items-center bg-fg px-3 py-2 text-sm font-medium text-bg transition-opacity hover:cursor-pointer hover:opacity-90',
    className,
  ]}
>
  <slot />
</button>
